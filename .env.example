# ============================================================================
# DocReady Environment Configuration Example (.env.example)
# Copy this file to .env.local for local development. Never commit real secrets.
# ============================================================================

# 1. Supabase Configuration (Auth, PostgreSQL with Dual-Level RLS, Private Storage)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. OCR Provider Configuration ('azure_read' | 'google_vision' | 'vision_llm' | 'mock')
DOCREADY_OCR_PROVIDER=mock
AZURE_DOC_INTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your-azure-doc-intel-key

# 3. Decision Provider Configuration ('jev_1.13.0' | 'rule_baseline' | 'mock')
DOCREADY_DECISION_PROVIDER=jev_1.13.0
JEV_API_KEY=your-jev-api-key

# 4. Operational Kill Switches ('true' or '1' disables the subsystem while keeping uploads open)
DOCREADY_KILL_OCR=false
DOCREADY_KILL_JEV=false
DOCREADY_KILL_AUTOCLASS=false
DOCREADY_KILL_EXPORT=false
