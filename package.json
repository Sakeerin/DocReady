{
  "name": "docready-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "lint": "node scripts/lint.mjs",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.21.0",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
